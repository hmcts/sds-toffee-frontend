// THIS PIPELINE IS FOR TESTING SHARED PIPELINE CODE ONLY

properties([
  parameters([
    string(name: 'LIB_VERSION', defaultValue: '2.7.3', description: 'Branch name of pipeline library to use')
  ])
])

def infrastructure = library "Infrastructure@${params.LIB_VERSION}"

node('ubuntu-sbox && !nightly') {
  timeout(time: 30, unit: 'MINUTES') {
    stage('Checkout') {
      checkout scm
    }

    stage('Validate Helm chart with kubeconform') {
      withEnv([
        'SUBSCRIPTION_NAME=sbox',
        'DEPLOYMENT_ENVIRONMENT=sbox',
        'REGISTRY_NAME=hmctssbox',
        'REGISTRY_SUBSCRIPTION=DCD-CFT-Sandbox',
        'DUAL_ACR_PUBLISH_ENABLED=false'
      ]) {
        def helm = infrastructure.uk.gov.hmcts.contino.Helm.new(this, 'apple-frontend')
        try {
          helm.authenticateAcr()
          helm.dependencyUpdate()
          sh(label: 'kubeconform version', script: 'kubeconform -v')
          helm.kubeconform()
        } finally {
          helm.restoreChartDependencyFiles()
        }
      }
    }
  }
}
