node('ubuntu-sbox && !nightly') {
  timeout(time: 30, unit: 'MINUTES') {
    stage('Checkout') {
      checkout scm
    }

    stage('Validate Helm chart with kubeconform') {
      sh(label: 'kubeconform schema validation', script: '''#!/usr/bin/env bash
        set -euo pipefail

        kubeconform_version="$(kubeconform -v)"
        echo "kubeconform version: $kubeconform_version"
        test "$kubeconform_version" = "v0.6.7"

        temp_dir="$(mktemp -d)"
        trap 'rm -rf "$temp_dir"' EXIT
        cp -R charts/apple-frontend "$temp_dir/apple-frontend"
        sed -i 's#oci://hmctsprod.azurecr.io/helm#oci://hmctssbox.azurecr.io/helm#' "$temp_dir/apple-frontend/Chart.yaml"

        export AZURE_CONFIG_DIR=/opt/jenkins/.azure-sbox
        az login --identity >/dev/null
        az acr login --name hmctssbox --subscription DCD-CFT-Sandbox
        helm dependency update "$temp_dir/apple-frontend"

        echo 'Validating base values'
        helm template apple-frontend "$temp_dir/apple-frontend" \
          -f "$temp_dir/apple-frontend/values.yaml" \
          | kubeconform \
              -strict \
              -summary \
              -ignore-missing-schemas \
              -kubernetes-version 1.35.0 \
              -schema-location default

        echo 'Validating values.sbox.template.yaml'
        helm template apple-frontend "$temp_dir/apple-frontend" \
          -f "$temp_dir/apple-frontend/values.yaml" \
          -f "$temp_dir/apple-frontend/values.sbox.template.yaml" \
          | kubeconform \
              -strict \
              -summary \
              -ignore-missing-schemas \
              -kubernetes-version 1.35.0 \
              -schema-location default
      ''')
    }
  }
}
